# Portable overrides. Customize before sourcing; never commit the local .env.
export LLAMA_BROKER_PROFILES="${XDG_CONFIG_HOME:-$HOME/.config}/llama-broker/profiles.json"
export LLAMA_BROKER_MODELS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/models"
export LLAMA_BROKER_RUNTIMES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/runtimes"
export LLAMA_BROKER_RUNTIME_CATALOG="$LLAMA_BROKER_RUNTIMES_DIR/catalog.json"
# API keys are generated with brokerctl security commands, not stored here.
