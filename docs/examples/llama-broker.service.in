# llama-broker systemd user unit template
#
# Rendered by `brokerctl setup` into ~/.config/systemd/user/llama-broker.service
# with {{REPO_DIR}} and {{USER_HOME}} substituted. Do not edit the installed
# copy directly — edit this template and re-run `brokerctl setup`.

[Unit]
Description=Llama-Broker bounded local model runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory={{REPO_DIR}}
Environment=HOME={{USER_HOME}}
Environment=PYTHONUNBUFFERED=1
Environment=LLAMA_BROKER_HOST=0.0.0.0
Environment=LLAMA_BROKER_PORT=11434
Environment=LLAMA_BROKER_BACKEND_URL=https://127.0.0.1:10000
Environment=LLAMA_BROKER_BACKEND_LISTEN_HOST=0.0.0.0
Environment=LLAMA_BROKER_BACKEND_LISTEN_PORT=10000
Environment=LLAMA_BROKER_SECURITY_FILE={{USER_HOME}}/.config/llama-broker/security.json
Environment=LLAMA_BROKER_CLIENT_URL=https://127.0.0.1:11434/v1
Environment=LLAMA_BROKER_MAX_WORKERS=2
Environment=LLAMA_BROKER_CONTROL_WORKERS=2
Environment=LLAMA_BROKER_CONTROL_CLIENT_TIMEOUT=2
Environment=LLAMA_BROKER_DRAIN_TIMEOUT=10
Environment=LLAMA_BROKER_TRANSITION_TIMEOUT=360
Environment=LLAMA_BROKER_STOP_TIMEOUT=90
Environment=LLAMA_BROKER_MAX_BODY_BYTES=33554432
Environment=LLAMA_BROKER_MAX_OUTPUT_TOKENS=16384
ExecStart=/usr/bin/python3 {{REPO_DIR}}/llama_broker.py
Restart=on-failure
RestartSec=5
MemoryHigh=768M
MemoryMax=1024M
MemorySwapMax=128M
TasksMax=64
TimeoutStopSec=600
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
